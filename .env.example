# Copy to .env and enter your own credentials. Offline validation needs none.
# EPA Clean Air Markets: https://www.epa.gov/power-sector/cam-api-portal
EPA_CAMD_API_KEY=

# EIA Open Data: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# Use your real project name and contact address for SEC requests.
SEC_USER_AGENT=Your research project (your.email@example.com)

# Optional paid model review, requested only with scripts/06_review.py --ai.
OPENAI_API_KEY=
