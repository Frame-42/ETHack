# Kopiere diese Datei nach .env und trage eigene Schluessel ein.
# Beide Registrierungen sind kostenlos und liefern den Schluessel sofort per Mail.

# EPA Clean Air Markets API — https://www.epa.gov/power-sector/cam-api-portal
EPA_CAMD_API_KEY=

# EIA Open Data API v2 — https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# SEC verlangt einen identifizierenden User-Agent mit Kontaktadresse
SEC_USER_AGENT=Projektname (deine.adresse@example.com)
